{
  "expo": {
    "name": "Courts Korea",
    "slug": "courts-korea",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "courtskorea",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/app-icon.png",
      "bundleIdentifier": "com.courtskorea.app",
      "supportsTablet": false,
      "associatedDomains": [
        "applinks:courtskorea.com"
      ]
    },
    "android": {
      "package": "com.courtskorea.app",
      "versionCode": 38,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "courtskorea.com",
              "pathPrefix": "/courts/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "googleServicesFile": "./google-services.json",
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID",
        "android.permission.ACCESS_ADSERVICES_AD_ID",
        "android.permission.ACCESS_ADSERVICES_ATTRIBUTION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-brand-foreground.png",
        "monochromeImage": "./assets/images/notification-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/with-android-release-optimization",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#30C27C",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "현재 위치를 기준으로 가까운 테니스장을 보여드리기 위해 위치 권한을 사용합니다."
        }
      ],
      [
        "expo-dev-client",
        {
          "launchMode": "launcher"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1A1A1A",
          "image": "./assets/images/splash-logo-padded.png",
          "imageWidth": 190,
          "resizeMode": "contain"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/analytics"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ecd2f686-154d-4bb7-a4f6-69d9ba27b3b1"
      }
    },
    "owner": "brgrer"
  }
}
